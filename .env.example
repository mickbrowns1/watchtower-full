# ── Rule verification app (the `verifier` container) ────────────────────────
# SDL/XDR host -- NOT the Management Console URL, the two are different hosts
# (see FoundStone's README "Requirements" section for why this matters).
SDL_BASE_URL=https://xdr.<region>.sentinelone.net
SDL_READ_TOKEN=<your SDL read token>
SDL_WRITE_TOKEN=<your SDL write token>
SDL_ACCOUNT_ID=<your account id>
S1_API_TOKEN=<your account-level API token, for detection-library sync>
VERIFY_DELAY=30
DRY_RUN=false

# ── Log simulator (`log-generator`/`syslog-ng` containers) ──────────────────
# DataPipeline HEC endpoint (Pipelines > Sources > + Add Source > HTTP Event Collector)
HEC_URL=https://ingest.<region>.sentinelone.net/services/collector/event
HEC_TOKEN=<your DataPipeline HEC token>
HEC_INDEX=watchtower

# Optional tuning
LOG_INTERVAL_MS=1500
LOG_BURST=5
SCENARIO_CHANCE=0.02

# ── Optional local Splunk sink (`ts-splunk`/`splunk` containers) ────────────
# See splunk/README.md for full install/usage. Not started unless you bring
# these services up explicitly (docker compose up -d ts-splunk splunk).
TS_AUTHKEY=tskey-auth-<your Tailscale auth key>
SPLUNK_PASSWORD=<choose a Splunk admin password, 8+ chars>
